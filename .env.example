# Copie para .env (local) ou configure no Vercel / GitHub Secrets. NUNCA commite o .env.
# Banco Neon (opcional: sem ele o painel funciona só com dados ao vivo, sem histórico)
DATABASE_URL=
# Segredo do Guardião (HMAC da config). Só o CEO deve ter. Gere um valor longo e aleatório.
GUARDIAN_SECRET=
# Protege /api/cron (o Vercel envia como Bearer)
CRON_SECRET=
# Opcional: agentes que usam LLM. Sem a chave, ficam "em espera".
ANTHROPIC_API_KEY=
# Opcional: alertas
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
